# ── Axion environment ─────────────────────────────────────────────────────────
# Copy to .env and adjust. Every value has a working default for a local demo.

# Database (used by the Compose `db` service; DATABASE_URL is derived for the API)
POSTGRES_USER=axion
POSTGRES_PASSWORD=axion
POSTGRES_DB=axion

# Session signing key — CHANGE THIS before exposing the app to anyone.
SECRET_KEY=dev-only-secret-change-me

# Where the browser talks to the app. GitHub OAuth redirects back through the web
# origin, so register this exact callback URL on your GitHub OAuth app:
#   {WEB_URL}/api/auth/github/callback
#
# This is also the origin the organisers' checker reads: [portal].base_url in the
# root .dogfood.toml is the portal, not the API, so all seven checks travel the
# same path a browser does (the web service proxies /api/* to FastAPI).
WEB_URL=http://localhost:3000

# Only used for direct API access during development; the browser normally
# reaches the API through the Next.js rewrite proxy on WEB_URL. The interactive
# API docs (Swagger UI) are served at {WEB_URL}/api/docs either way.
API_PUBLIC_URL=http://localhost:8000

# Event window. Commit Integrity compares submission commit history against this,
# and it is also the submission deadline — enforced server-side against the
# server clock, never the browser's. ISO-8601.
#
# These values are the deployment's *defaults*, not its last word: an organiser
# can take the clock over at run time from /admin → Event setup (or directly,
# PATCH /api/admin/event), which stores one attributed row in `event_settings`
# without touching this file, and hands it back with DELETE from the same panel.
# Nothing here is overwritten, and an empty table means the values below are the
# window — which is why a fresh boot still enforces the fixture dataset's
# already-closed deadline. Changing this file needs a restart; moving the clock in
# the console does not.
#
# Leave both blank and you get a 72-hour event that is OPEN NOW. (A blank
# EVENT_END used to resolve to "ended at boot", which silently closed submissions
# on the one-command path: anyone who copied no .env could not draft or submit.)
# An explicit value always wins, so an event you close stays closed.
#
# Both are ignored entirely in fixture mode (EVENT_SOURCE=fixtures, which is the
# compose default): there, the dataset's own event name and deadline are
# authoritative. See EVENT_SOURCE below.
EVENT_NAME=Axion Demo Hackathon
EVENT_START=
EVENT_END=

# Where the window comes from: `env` (the application default) or `fixtures`
# (the compose default), which reads the event name and window from the dataset.
# An imported dataset brings its own deadline, and a closed fixture event only
# means anything if the server enforces *that* deadline. In fixture mode the
# dataset's window is authoritative and EVENT_START/EVENT_END above are ignored:
# letting an environment value re-open an already-closed event would make the
# acceptance result depend on local configuration rather than on the code.
EVENT_SOURCE=

# The community window (T3) is its own clock, for the same reason the submission
# window is: an event can stop accepting work and still be taking votes. Left
# blank it is derived from the event — it opens with it and closes three days
# after it — and like the submission window it is a *default*: an organiser can
# move it at run time from /admin → Event setup, independently of the deadline.
VOTING_OPENS_AT=
VOTING_CLOSES_AT=

# One-flag alias for the fixture dataset: DOGFOOD_FIXTURE_MODE=true implies
# SEED_MODE=fixtures + EVENT_SOURCE=fixtures and enables the same offline /
# checker-header gate as SEED_DEMO. Explicit SEED_MODE, EVENT_SOURCE or
# LOCAL_DEV_LOGIN values still win; blank values do not count as explicit.
DOGFOOD_FIXTURE_MODE=false

# GitHub OAuth (optional). Without these the "Continue with GitHub" button hides
# and participants can still register with email + password.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# GitHub API token (optional, raises rate limit 60→5000 req/hr).
GITHUB_TOKEN=

# When true, commit integrity is computed from deterministic synthetic data
# instead of calling the GitHub API. Keep true for demos and offline judging.
MOCK_GITHUB=true

# Seed a dataset on boot.
#
#   (blank)             same as SEED_MODE=fixtures, which docker-compose.yml
#                       defaults to. The one-command path runs the acceptance
#                       dataset, because that is the instance the committed
#                       acceptance report was produced from.
#   SEED_MODE=fixtures  the organisers' fixtures.json at the repository root,
#                       loaded as published: 41 projects (including the duplicate
#                       submission), 30 judges, 40 teams, 8 tracks, 131 scores,
#                       and an event whose submissions_close is already in the
#                       past. Pair it with EVENT_SOURCE=fixtures, or use
#                       DOGFOOD_FIXTURE_MODE=true, which sets both.
#   SEED_MODE=demo      Axion's own generated dataset, at
#                       data/axion-fixtures.json: 50 participants, 10 teams, 10
#                       projects, 5 judges, 50 verdicts, 3 tracks, prizes, the
#                       default 30/70 rubric, and an open window. Every number
#                       quoted in README.md and JUDGING.md was computed against
#                       this one, and it is the dataset the raw-average-vs-Z-score
#                       demonstration needs.
#
#     python -m app.seed        # honours SEED_MODE
SEED_MODE=
SEED_DEMO=false

# ── Offline mode ──────────────────────────────────────────────────────────────
# Axion has to work on a laptop with the network switched off, so it ships a
# passwordless local login next to GitHub OAuth:
#
#   POST /api/auth/dev-login   {"role": "admin" | "judge" | "participant"}
#
# plus these seeded accounts, all with the password "password":
#
#   admin@axion.local    organiser
#   hacker@axion.local   participant, already on a team
#
# With SEED_MODE=fixtures the accounts come from the imported dataset instead,
# with their addresses taken from the file and no password: the four literal
# session headers below are how an acceptance checker signs in, and the seed
# prints them at boot.
#
#   organiser@sample-hack-2026.dogfood   organiser (created by the import)
#   tomas.varga@example.org              judge_a  (jdg_01)
#   wei.lindqvist@example.org            judge_b  (jdg_02)
#   priya1@example.org                   participant, a member of tm_01
#
# "Login as Judge" signs in as the first seeded judge, who has verdicts to inspect.
#
# The endpoint is enabled by MOCK_GITHUB, SEED_DEMO, SEED_MODE=fixtures or
# DOGFOOD_FIXTURE_MODE, so a real deployment has it switched off and returns 403.
# Leave this false for a live event; setting it true publishes a passwordless
# admin login. See THREAT-MODEL.md.
LOCAL_DEV_LOGIN=false

# The same gate covers the acceptance checker's credentials, because the
# organisers' checker attaches a header string instead of logging in and has no
# way to fetch one:
#
#   Cookie: session=axion-organizer-1     organizer
#   Cookie: session=axion-judge-a-1       judge_a   (jdg_01)
#   Cookie: session=axion-judge-b-1       judge_b   (jdg_02)
#   Cookie: session=axion-participant-1   participant
#
# These are literal and fixed, and are written into the root .dogfood.toml, so
# the acceptance report can be reproduced exactly. They are accepted only while
# this deployment is explicitly a demo (the gate above); a live event answers 401
# to all four. The seed and the API print them at boot.
#
#   GET /api/dev/checker-headers
#     -> the same four roles as signed Authorization: Bearer tokens
#
# The signed tokens are deliberately long-lived too: a report has to stay
# reproducible. Set AXION_ANNOUNCE_ACCESS=false to silence the boot banner.
AXION_ANNOUNCE_ACCESS=true

# Set true when serving over HTTPS (marks the session cookie Secure).
COOKIE_SECURE=false
